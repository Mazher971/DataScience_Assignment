        "        print(f\"Ingested chunk {i+1} with {len(chunk)} records\")\n",
        "        print(chunk.head())\n",
        "\"\"\"\n",
        "\n",
        "with open('scripts/ingest.py', 'w') as f:\n",
        "    f.write(ingest_script_content)\n",
        "\n",
