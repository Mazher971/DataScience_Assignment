        "\n",
        "# Write the preprocess.py file\n",
        "preprocess_script_content = \"\"\"\n",
        "import nltk\n",
        "from nltk.corpus import stopwords\n",
        "from nltk.tokenize import word_tokenize\n",
        "\n",
        "# Download necessary NLTK data if not already downloaded\n",
        "try:\n",
        "    nltk.data.find('tokenizers/punkt')\n",
        "except nltk.downloader.DownloadError:\n",
        "    nltk.download('punkt')\n",
        "try:\n",
        "    nltk.data.find('corpora/stopwords')\n",
        "except nltk.downloader.DownloadError:\n",
        "    nltk.download('stopwords')\n",
        "\n",
        "stop_words = set(stopwords.words('english'))\n",
        "\n",
        "def preprocess_text(text):\n",
        "    \\\"\\\"\\\"\n",
        "    Cleans text data by performing tokenization and removing stop words.\n",
        "\n",
        "    Args:\n",
        "        text (str): The input text string.\n",
        "\n",
        "    Returns:\n",
        "        str: The cleaned text string.\n",
        "    \\\"\\\"\\\"\n",
        "    if not isinstance(text, str):\n",
        "        return \"\" # Return empty string or handle non-string input as appropriate\n",
        "\n",
        "    # Tokenize the text\n",
        "    tokens = word_tokenize(text.lower())\n",
        "    # Remove stop words and non-alphabetic tokens\n",
        "    processed_tokens = [word for word in tokens if word.isalpha() and word not in stop_words]\n",
        "    return \" \".join(processed_tokens)\n",
        "\n",
        "if __name__ == '__main__':\n",
        "    # Example usage:\n",
        "    sample_text = \"This is an example sentence with some stop words and punctuation!\"\n",
        "    cleaned_text = preprocess_text(sample_text)\n",
        "    print(f\"Original text: {sample_text}\")\n",
        "    print(f\"Cleaned text: {cleaned_text}\")\n",
        "\n",
        "    sample_text_2 = \"Another example, showing numbers like 123 and symbols like @#$.\"\n",
        "    cleaned_text_2 = preprocess_text(sample_text_2)\n",
        "    print(f\"Original text: {sample_text_2}\")\n",
        "    print(f\"Cleaned text: {cleaned_text_2}\")\n",
        "\"\"\"\n",
        "\n",
        "with open('scripts/preprocess.py', 'w') as f:\n",
        "    f.write(preprocess_script_content)\n",
        "\n",
        "print(\"Created scripts/preprocess.py\")"
