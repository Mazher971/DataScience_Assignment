        "# Write the ingest.py file\n",
        "ingest_script_content = \"\"\"\n",
        "import json\n",
        "import time\n",
        "import pandas as pd\n",
        "\n",
        "def ingest_data(file_path):\n",
        "    \\\"\\\"\\\"\n",
        "    Reads data from a JSONL file, simulating reading in chunks over time.\n",
        "\n",
        "    Args:\n",
        "        file_path (str): The path to the JSONL file.\n",
        "\n",
        "    Yields:\n",
        "        pandas.DataFrame: A DataFrame containing a chunk of data.\n",
        "    \\\"\\\"\\\"\n",
        "    data_chunk = []\n",
        "    chunk_size = 10  # Define a chunk size for simulation\n",
        "    with open(file_path, \"r\", encoding=\"utf-8\") as f:\n",
        "        for line in f:\n",
        "            data_chunk.append(json.loads(line))\n",
        "            if len(data_chunk) == chunk_size:\n",
        "                yield pd.DataFrame(data_chunk)\n",
        "                data_chunk = []\n",
        "                # Simulate a time delay (optional)\n",
        "                # time.sleep(1)\n",
        "\n",
        "        # Yield any remaining data\n",
        "        if data_chunk:\n",
        "            yield pd.DataFrame(data_chunk)\n",
        "\n",
        "if __name__ == '__main__':\n",
        "    # Example usage:\n",
        "    file_path = '../data/sample_stream_large.jsonl'  # Adjust the path as needed\n",
